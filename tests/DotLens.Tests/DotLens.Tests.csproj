<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Lets the tests run where only a newer .NET runtime is installed, as on CI with only SDK 11. -->
    <RollForward>Major</RollForward>
    <!-- Suppress xUnit1051: Test methods should use TestContext.Current.CancellationToken -->
    <!-- Most tests here don't need external cancellation support -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotLens\DotLens.csproj" />
  </ItemGroup>

</Project>
